# Database Configuration (PostgreSQL)
# For local host execution:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eve_healthcare
# For Docker Compose execution (service name 'db'):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/eve_healthcare

# PostgreSQL Container Credentials (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eve_healthcare

# Security & JWT Configuration
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Webhook Configuration
WEBHOOK_SECRET=optional-payment-provider-webhook-shared-secret

# Application Settings
PROJECT_NAME="EVE Healthcare API"
DEBUG=False
